# 复制本文件为 .env 并填入真实值。.env 不会被提交到 git。

# DeepSeek
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash

# 服务
HTTP_PORT=8091

# 语音合成（TTS）。留空时朗读接口不注册，费曼提问只有文字没有声音。
SPEECH_API_KEY=

# DashScope Paraformer 实时 ASR。启用、密钥和 Workspace ID 必须同时配置，重启后端后才注册 WebSocket 路由。
# 只使用华北 2（北京）Workspace；密钥不得写进 config.yaml、日志或验收文档。
VOICE_REALTIME_ENABLED=false
VOICE_REALTIME_API_KEY=
VOICE_REALTIME_WORKSPACE_ID=

# PostgreSQL（与 config.yaml 对齐）
POSTGRES_PASSWORD=root

