# 复制本文件为 .env 并填入真实值。.env 不会被提交到 git。

# DeepSeek
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash

# 服务
HTTP_PORT=8091

# 语音识别（STT）。留空时自动降级为本地占位供应商，服务照常启动，只是转写出来是占位文案。
# 密钥在 https://platform.xiaomimimo.com 控制台申请，与 DeepSeek 的密钥是两套，不能混用。
FEYNMAN_STT_API_KEY=
# 语音合成（TTS）。留空时朗读接口不注册，费曼提问只有文字没有声音。
# 同一个 MiMo 平台的密钥，可以直接填与 FEYNMAN_STT_API_KEY 相同的值。
SPEECH_API_KEY=

# DashScope Paraformer 实时 ASR。任务 1 仅供协议客户端使用，尚未开放浏览器 WebSocket。
VOICE_REALTIME_API_KEY=
VOICE_REALTIME_WORKSPACE_ID=

# PostgreSQL（与 config.yaml 对齐）
POSTGRES_PASSWORD=root

